# Copie para .env e ajuste. Nunca versione o .env real.

ENVIRONMENT=development
APP_VERSION=0.1.0

# Banco de dados (async driver obrigatorio: postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Auth - gere um segredo real com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-em-producao-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - lista separada por virgula
CORS_ORIGINS=http://localhost:3000
